---
import ProjectGallery from './ProjectGallery.astro';
import { withBase } from '../utils/withBase';

interface Props {
	title: string;
	domain: string;
	api?: string;
	category: string;
	year: number;
	summary: string;
	role?: string;
	problem?: string;
	approach?: string[];
	outcomes?: string[];
	engine: string;
	features: string[];
	performanceMetrics?: string[];
	externalUrl?: string;
	externalLabel?: string;
	evidenceLinks?: { label: string; url: string }[];
	caseStudyHref?: string;
	standalone?: boolean;
	youtubeUrl?: string;
	images?: string[];
	buildMode?: string;
	buildNote?: string;
	hasNotes?: boolean;
	Content: any;
}

const {
	title,
	domain,
	api,
	category,
	year,
	summary,
	role,
	problem,
	approach = [],
	outcomes = [],
	engine,
	features,
	performanceMetrics = [],
	externalUrl,
	externalLabel,
	evidenceLinks = [],
	caseStudyHref,
	standalone = false,
	youtubeUrl,
	images = [],
	buildMode,
	buildNote,
	hasNotes = true,
	Content
} = Astro.props as Props;

const Wrapper = standalone ? 'div' : 'template';
const linkLabel = externalLabel ?? (externalUrl && new URL(externalUrl).hostname === 'github.com' ? 'Repository' : 'Project website');


const hasTechnicalNotes = features.length > 0 || performanceMetrics.length > 0 || Boolean(buildNote) || hasNotes;
---

<Wrapper class:list={[!standalone && 'atlas-island-template']}>
  <article class="project-page" data-case-study data-case-title={title}>
    <header class="project-heading">
      <p class="project-meta">{domain} · {year}</p>
      <h1>{title}</h1>
    </header>
    <ProjectGallery title={title} images={images} />
    <div class="project-copy">
      <p class="project-intro">{summary}</p>
      {(youtubeUrl || externalUrl || evidenceLinks.length > 0) && <nav class="project-links" aria-label="Project links">
        {youtubeUrl && <a href={youtubeUrl} target="_blank" rel="noreferrer">Watch demo ↗</a>}
        {externalUrl && <a href={externalUrl} target="_blank" rel="noreferrer">{linkLabel} ↗</a>}
        {evidenceLinks.map(link => <a href={link.url} target="_blank" rel="noreferrer">{link.label} ↗</a>)}
      </nav>}
      {role && <section class="copy-section"><h2>My role</h2><p>{role}</p></section>}
      {problem && <section class="copy-section"><h2>What it solves</h2><p>{problem}</p></section>}
      {outcomes.length > 0 && <section class="copy-section"><h2>What it delivers</h2><ul>{outcomes.slice(0,3).map(item => <li>{item}</li>)}</ul></section>}
      {approach.length > 0 && <section class="copy-section"><h2>Key decisions</h2><ul>{approach.slice(0,3).map(item => <li>{item}</li>)}</ul></section>}
      {hasTechnicalNotes && <details class="project-detail">
        <summary>Explore the technical details</summary>
        <div class="detail-content">
          <p class="project-meta">{engine}{api && api !== engine ? ` · ${api}` : ''}</p>
          {features.length > 0 && <section class="copy-section"><h2>Capabilities</h2><ul>{features.map(item => <li>{item}</li>)}</ul></section>}
          {performanceMetrics.length > 0 && <section class="copy-section"><h2>Verification and engineering notes</h2><ul>{performanceMetrics.map(item => <li>{item}</li>)}</ul></section>}
          {approach.length > 3 && <section class="copy-section"><h2>Further decisions</h2><ul>{approach.slice(3).map(item => <li>{item}</li>)}</ul></section>}
          {outcomes.length > 3 && <section class="copy-section"><h2>Further outcomes</h2><ul>{outcomes.slice(3).map(item => <li>{item}</li>)}</ul></section>}
          {buildNote && <section class="copy-section"><h2>Development workflow</h2><p>{buildNote}</p></section>}
          {hasNotes && <div class="project-story"><Content /></div>}
        </div>
      </details>}
      <footer class="project-links contact-links">
        <a href={withBase('/alex-mollard-cv.pdf', import.meta.env.BASE_URL)} download>Download CV ↓</a>
        <a href="mailto:alexmollard@protonmail.com">Email me ↗</a>
        <a href="https://au.linkedin.com/in/alex-mollard" target="_blank" rel="noreferrer">LinkedIn ↗</a>
      </footer>
    </div>
  </article>
</Wrapper>
<style>
  .project-page { max-width: 76rem; margin-inline: auto; color: var(--color-paper); }
  .project-heading { padding: 1.5rem 0 .5rem; }
  .project-meta { color: var(--color-muted); font-size: .8rem; line-height: 1.5; }
  h1 { margin-top: .6rem; font-size: clamp(2.3rem, 5vw, 4rem); font-weight: 600; letter-spacing: -.045em; line-height: 1.1; overflow-wrap: anywhere; }
  .project-copy { max-width: 48rem; margin: 2rem auto 0; }
  .project-intro { font-size: 1.15rem; line-height: 1.65; color: var(--color-paper); }
  .project-links { display: flex; flex-wrap: wrap; gap: .6rem 1.3rem; margin-top: 1rem; }
  .project-links a { font-size: .85rem; color: var(--color-paper); text-decoration: underline; text-decoration-color: var(--color-signal); text-underline-offset: .25rem; }
  .copy-section { margin-top: 1.65rem; }
  .copy-section h2 { margin-bottom: .5rem; font-size: 1rem; font-weight: 600; line-height: 1.4; }
  .copy-section p, .copy-section li { color: var(--color-muted); font-size: .95rem; line-height: 1.65; }
  .copy-section ul { list-style: disc; padding-left: 1.15rem; display: grid; gap: .45rem; }
  .copy-section li::marker { color: var(--color-signal); }
  .project-detail { margin-top: 2rem; border-block: 1px solid var(--color-line); }
  .project-detail > summary { padding: 1rem 0; cursor: pointer; font-size: .9rem; font-weight: 500; }
  .detail-content { padding-bottom: 1.5rem; }
  .project-story { color: var(--color-muted); font-size: .95rem; line-height: 1.65; margin-top: 1.5rem; }
  .project-story :global(h2) { color: var(--color-paper); font-size: 1rem; font-weight: 600; margin: 1.5rem 0 .5rem; }
  .project-story :global(p + p) { margin-top: .8rem; }
  .contact-links { margin-top: 1.25rem; padding-bottom: 1rem; }
  a:focus-visible, summary:focus-visible { outline: 2px solid var(--color-signal); outline-offset: 4px; }
  @media (max-width: 640px) { .project-copy { margin-top: 1.25rem; } .project-intro { font-size: 1.05rem; } }
</style>
