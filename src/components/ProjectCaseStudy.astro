---
import ProjectMedia from './ProjectMedia.astro';
import TechSpecs from './TechSpecs.astro';

interface Props {
	title: string;
	domain: string;
	api?: string;
	category: string;
	year: number;
	summary: string;
	role?: string;
	problem?: string;
	approach?: string[];
	outcomes?: string[];
	engine: string;
	features: string[];
	performanceMetrics?: string[];
	externalUrl?: string;
	youtubeUrl?: string;
	images?: string[];
	hasNotes?: boolean;
	Content: any;
}

const {
	title,
	domain,
	api,
	category,
	year,
	summary,
	role,
	problem,
	approach = [],
	outcomes = [],
	engine,
	features,
	performanceMetrics = [],
	externalUrl,
	youtubeUrl,
	images = [],
	hasNotes = true,
	Content
} = Astro.props as Props;

const hasMedia = Boolean(youtubeUrl) || images.length > 0;
const hasStory = approach.length > 0 || hasNotes;
const splitStory = approach.length > 0 && hasNotes;
const splitOverview = Boolean(role || problem) && outcomes.length > 0;

const tabs = [
	{ id: 'overview', label: 'Overview', count: 0, show: true },
	{ id: 'approach', label: approach.length > 0 ? 'Approach' : 'Notes', count: approach.length, show: hasStory },
	{ id: 'technical', label: 'Technical', count: features.length, show: true },
	{ id: 'media', label: 'Media', count: images.length + (youtubeUrl ? 1 : 0), show: hasMedia }
].filter((tab) => tab.show);

const activeTab = tabs[0].id;
---

<template class="atlas-island-template">
	<article class="case-study" data-case-study data-case-title={title}>
		<header class="case-study-head">
			<div class="flex flex-wrap items-start justify-between gap-x-6 gap-y-3">
				<div class="min-w-0">
					<p class="mono text-[10px] uppercase tracking-[0.14em] text-signal">Case study</p>
					<h3 class="mt-1.5 text-2xl font-semibold leading-tight text-paper md:text-3xl">{title}</h3>
				</div>
				<div class="flex flex-wrap items-center gap-2">
					<span class="atlas-chip">{domain}</span>
					{api && <span class="atlas-chip">{api}</span>}
					<span class="atlas-chip">{category}</span>
					<span class="atlas-chip">{year}</span>
					{externalUrl && (
						<a href={externalUrl} target="_blank" rel="noreferrer" class="atlas-chip case-study-link">Repository ↗</a>
					)}
				</div>
			</div>

			<div class="case-study-tabs" role="tablist" aria-label={`${title} sections`}>
				{tabs.map((tab) => (
					<button
						type="button"
						role="tab"
						id={`case-tab-${tab.id}`}
						class="case-study-tab"
						data-case-tab={tab.id}
						aria-controls={`case-panel-${tab.id}`}
						aria-selected={tab.id === activeTab ? 'true' : 'false'}
						tabindex={tab.id === activeTab ? 0 : -1}
					>
						{tab.label}
						{tab.count > 0 && <span class="case-study-tab-count">{tab.count}</span>}
					</button>
				))}
			</div>
		</header>

		<div class="case-study-body">
			<section
				id="case-panel-overview"
				class="case-study-panel"
				role="tabpanel"
				aria-labelledby="case-tab-overview"
				data-case-panel="overview"
				tabindex="0"
				hidden={activeTab !== 'overview'}
			>
				<p class="case-study-lead">{summary}</p>

				<div class:list={['mt-5 grid items-start gap-4', splitOverview && 'xl:grid-cols-2']}>
					{(role || problem) && (
						<div class="space-y-4">
							{role && (
								<section class="case-study-block">
									<p class="case-study-label">Role</p>
									<p class="mt-2 text-sm leading-relaxed text-paper">{role}</p>
								</section>
							)}
							{problem && (
								<section class="case-study-block">
									<p class="case-study-label">Problem</p>
									<p class="mt-2 text-sm leading-relaxed text-muted">{problem}</p>
								</section>
							)}
						</div>
					)}

					{outcomes.length > 0 && (
						<section class="case-study-block case-study-block-accent">
							<p class="case-study-label">Outcome</p>
							<ul class="case-study-list">
								{outcomes.map((item) => <li>{item}</li>)}
							</ul>
						</section>
					)}
				</div>
			</section>

			{hasStory && (
				<section
					id="case-panel-approach"
					class="case-study-panel"
					role="tabpanel"
					aria-labelledby="case-tab-approach"
					data-case-panel="approach"
					tabindex="0"
					hidden={activeTab !== 'approach'}
				>
					<div class:list={['grid items-start gap-4', splitStory && 'xl:grid-cols-[1.05fr_0.95fr]']}>
						{approach.length > 0 && (
							<section class="case-study-block">
								<p class="case-study-label">Approach</p>
								<ul class="case-study-list">
									{approach.map((item) => <li>{item}</li>)}
								</ul>
							</section>
						)}

						{hasNotes && (
							<section class="case-study-block atlas-expanded-body text-sm leading-relaxed text-muted">
								<p class="case-study-label mb-3">Project notes</p>
								<Content />
							</section>
						)}
					</div>
				</section>
			)}

			<section
				id="case-panel-technical"
				class="case-study-panel"
				role="tabpanel"
				aria-labelledby="case-tab-technical"
				data-case-panel="technical"
				tabindex="0"
				hidden={activeTab !== 'technical'}
			>
				<TechSpecs
					engine={engine}
					api={api}
					features={features}
					performanceMetrics={performanceMetrics}
				/>
			</section>

			{hasMedia && (
				<section
					id="case-panel-media"
					class="case-study-panel"
					role="tabpanel"
					aria-labelledby="case-tab-media"
					data-case-panel="media"
					tabindex="0"
					hidden={activeTab !== 'media'}
				>
					<ProjectMedia title={title} youtubeUrl={youtubeUrl} images={images} />
				</section>
			)}
		</div>
	</article>
</template>
