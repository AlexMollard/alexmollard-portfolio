---
import { withBase } from '../utils/withBase';
interface Props { title: string; images: string[]; compact?: boolean; card?: boolean; previewHref?: string; }
const { title, images: suppliedImages, compact = false, card = false, previewHref } = Astro.props;
const isPlaceholder = suppliedImages.length === 0;
const images = isPlaceholder ? ['/media/project-placeholder.svg'] : suppliedImages;
---
{images.length > 0 && <project-gallery class:list={['project-gallery', compact && 'gallery-compact', card && 'gallery-card']} data-placeholder={isPlaceholder ? "true" : undefined} role="region" aria-label={`${title} screenshots`}>
  {isPlaceholder && <div class="gallery-placeholder-label"><strong>{title}</strong><span>Project cover · screenshots to come</span></div>}
  <div class="gallery-track" tabindex="0" aria-label="Screenshots — swipe or use arrow keys">
    {images.map((src, index) => <a class="gallery-slide" style={card ? { "--slide-image": `url("${withBase(src, import.meta.env.BASE_URL)}")` } : undefined} tabindex={card ? -1 : undefined} data-preview-link={card ? true : undefined} href={card && previewHref ? previewHref : withBase(src, import.meta.env.BASE_URL)} target={card ? undefined : "_blank"} rel="noreferrer" aria-label={card ? `Preview ${title}` : `Open ${title} screenshot ${index + 1} at full size`}>
      <img data-fallback={withBase("/media/project-placeholder.svg", import.meta.env.BASE_URL)} src={withBase(src, import.meta.env.BASE_URL)} alt={isPlaceholder ? `${title} project cover` : `${title} screenshot ${index + 1}`} width="1600" height="900" loading={!card && index === 0 ? 'eager' : 'lazy'} decoding="async" />
    </a>)}
  </div>
  {images.length > 1 && <div class="gallery-controls">
    <button type="button" data-gallery-prev aria-label="Previous screenshot" disabled>←</button>
    <span class="gallery-count" aria-live="polite" aria-atomic="true">1 / {images.length}</span>
    <button type="button" data-gallery-next aria-label="Next screenshot">→</button>
  </div>}
  {images.length === 1 && !card && !isPlaceholder && <p class="gallery-hint">Select image to view full size</p>}
</project-gallery>}
<script>import '../scripts/project-gallery';</script>
<style is:global>
  .project-gallery { position: relative; display: block; min-width: 0; margin: 1.8rem 0; }
  .gallery-track { display: flex; width: 100%; aspect-ratio: 16 / 9; overflow-x: auto; overflow-y: hidden; scroll-snap-type: x mandatory; overscroll-behavior: auto; scrollbar-width: none; background: rgb(0 0 0 / .18); border: 1px solid var(--color-line); border-radius: .15rem; }
  .gallery-slide { flex: 0 0 100%; min-width: 0; height: 100%; scroll-snap-align: start; display: block; }
  .gallery-slide img { width: 100%; height: 100%; display: block; object-fit: contain; }
  .gallery-controls { display: flex; justify-content: center; align-items: center; gap: 1rem; margin-top: .6rem; }
  .gallery-controls button { height: 44px; width: 44px; border: 1px solid var(--color-line); border-radius: .15rem; font-size: 1.15rem; cursor: pointer; }
  .gallery-controls button:disabled { opacity: .3; cursor: default; }
  .gallery-controls button:not(:disabled):hover { background: var(--color-raised); }
  .gallery-count, .gallery-hint { color: var(--color-muted); font-size: .75rem; text-align: center; }
  .gallery-hint { margin-top: .65rem; }
  .project-gallery:not([data-enhanced]) .gallery-controls { display: none; }
  .gallery-compact { margin: 0; }
  .gallery-compact .gallery-track { aspect-ratio: 4 / 3; }
  .gallery-track:focus-visible, .gallery-controls button:focus-visible { outline: 2px solid var(--color-signal); outline-offset: 3px; }
  .gallery-track::-webkit-scrollbar { display: none; }
  .gallery-card { position: relative; z-index: 1; margin: 0; }
  .gallery-card .gallery-track { border: 0; border-radius: 0; aspect-ratio: 16 / 9; }
  .gallery-card .gallery-slide { cursor: grab; }
  .gallery-card .gallery-slide { position: relative; overflow: hidden; background: #101719; }
  .gallery-card .gallery-slide img { position: relative; z-index: 1; object-fit: contain; object-position: center; }
  .gallery-card .gallery-slide::before { content: ''; position: absolute; inset: -1rem; background-image: var(--slide-image); background-size: cover; background-position: center; filter: blur(18px); opacity: .22; }
  .gallery-card .gallery-controls { position: absolute; inset: 0; margin: 0; justify-content: space-between; padding: .65rem; pointer-events: none; }
  .gallery-card .gallery-controls button { pointer-events: auto; color: white; background: rgb(10 12 14 / .85); border-color: rgb(255 255 255 / .3); }
  .gallery-card .gallery-count { position: absolute; bottom: .6rem; left: 50%; transform: translateX(-50%); padding: .15rem .5rem; border-radius: 1rem; color: white; background: rgb(10 12 14 / .85); }
  .gallery-track { cursor: grab; }
  .gallery-track.is-dragging { cursor: grabbing; scroll-snap-type: none; user-select: none; }
  .gallery-slide img { -webkit-user-drag: none; user-select: none; }
  .gallery-placeholder-label { position: absolute; inset: 0; display: flex; flex-direction: column; justify-content: center; align-items: center; gap: .75rem; text-align: center; padding: 2rem; pointer-events: none; z-index: 2; }
  .gallery-placeholder-label strong { font-size: clamp(1.2rem, 3vw, 2rem); max-width: 22ch; }
  .gallery-placeholder-label span { font-size: .7rem; color: var(--color-muted); }
</style>
