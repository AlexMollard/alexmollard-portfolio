---
interface Props {
	engine: string;
	api?: string;
	features: string[];
	performanceMetrics?: string[];
}

const { engine, api, features, performanceMetrics = [] } = Astro.props as Props;
---

<div class="space-y-4" aria-label="Technical profile">
	<dl class="case-study-facts">
		<div>
			<dt class="case-study-label">Engine</dt>
			<dd class="mt-1.5 text-sm text-paper">{engine}</dd>
		</div>
		{api && (
			<div>
				<dt class="case-study-label">Graphics API</dt>
				<dd class="mt-1.5 text-sm text-paper">{api}</dd>
			</div>
		)}
	</dl>

	<div class="grid items-start gap-4 xl:grid-cols-2">
		<section class="case-study-block">
			<p class="case-study-label">Capabilities</p>
			<ul class="case-study-list">
				{features.map((feature) => <li>{feature}</li>)}
			</ul>
		</section>

		{performanceMetrics.length > 0 && (
			<section class="case-study-block">
				<p class="case-study-label">Engineering signals</p>
				<ul class="case-study-list">
					{performanceMetrics.map((metric) => <li>{metric}</li>)}
				</ul>
			</section>
		)}
	</div>
</div>
