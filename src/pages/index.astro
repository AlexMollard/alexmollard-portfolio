---
import { getCollection } from 'astro:content';
import ProjectGallery from '../components/ProjectGallery.astro';
import ProjectPreview from '../components/ProjectPreview.astro';
import HeroGrid from '../components/HeroGrid.astro';
import Layout from '../layouts/Layout.astro';
import { withBase } from '../utils/withBase';

const projects = (await getCollection('projects')).sort((a, b) => {
	const byDate = b.data.date.getTime() - a.data.date.getTime();
	return byDate !== 0 ? byDate : a.data.title.localeCompare(b.data.title);
});

const atlasProjects = projects.map((project) => ({
	project,
	domain: project.data.domain,
	year: project.data.date.getFullYear()
}));

const shippedTitles = atlasProjects.filter(
	(item) => item.project.data.category === 'Professional' && item.domain !== 'Tools'
);
const shippedTitleCount = shippedTitles.length;
const shippedSinceYear = Math.min(...shippedTitles.map((item) => item.year));

const cvHref = withBase('/alex-mollard-cv.pdf', import.meta.env.BASE_URL);
const domains = [...new Set(atlasProjects.map((item) => item.domain))].sort();
const categories = [...new Set(atlasProjects.map((item) => item.project.data.category))];
const apis = [...new Set(atlasProjects.map((item) => item.project.data.api).filter(Boolean))].sort();
const years = [...new Set(atlasProjects.map((item) => item.year))].sort((a, b) => b - a);
const spotlightProjects = atlasProjects
	.filter((item) => item.project.data.spotlight_order !== undefined)
	.sort((a, b) => (a.project.data.spotlight_order ?? 999) - (b.project.data.spotlight_order ?? 999));
---

	<Layout
		title="Alex Mollard | Senior Software Engineer"
		description="Software engineer in Melbourne building production tools, applications and cross-platform systems, with agent-assisted development using Oh my PI and Claude Code."
>
	<header id="top" class="reveal-in relative left-1/2 -mx-[50dvw] -mt-10 w-[100dvw] md:-mt-14">
		<section class="hero-stage w-[100dvw] px-6 pb-12 pt-8 sm:px-10 md:pb-16 md:pt-10 lg:px-14">
			<HeroGrid />
			<div class="mx-auto max-w-[104rem]">
				<nav class="hero-nav flex flex-wrap items-center justify-between gap-4 border-b border-line pb-4" aria-label="Primary navigation">
					<a href="#top" class="mono text-[10px] uppercase tracking-[0.16em] text-paper">Alex Mollard / Portfolio</a>
					<div class="flex flex-wrap items-center gap-x-5 gap-y-2">
						<a href="#selected-work" class="hero-nav-link">Selected work</a>
						<a href="#how-i-work" class="hero-nav-link">How I work</a>
						<a href="#archive" class="hero-nav-link">Archive</a>
						<a href="https://github.com/AlexMollard" target="_blank" rel="noreferrer" class="hero-nav-link">GitHub ↗</a>
					</div>
				</nav>

				<div class="hero-layout grid gap-10 py-14 md:py-18 lg:grid-cols-[minmax(0,0.92fr)_minmax(30rem,1.08fr)] lg:items-end lg:gap-16 lg:py-20">
					<div class="hero-intro max-w-3xl">
						<p class="mono text-[11px] uppercase tracking-[0.16em] text-signal">Senior Software Engineer · Melbourne</p>
						<h1 class="mt-6 text-[clamp(4.1rem,8vw,8.8rem)] font-medium leading-[0.8] text-paper">
							Alex<br />Mollard
						</h1>
						<p class="mt-9 max-w-2xl text-lg leading-relaxed text-muted md:text-[1.35rem]">
							I build production tools, applications and cross-platform systems. My work spans commercial software delivery, mobile development and AI-assisted engineering with Oh my PI and Claude Code.
						</p>
						<div class="mt-8 flex flex-wrap gap-3">
							<a href="mailto:alexmollard@protonmail.com" class="hero-action hero-action-primary">Email me <span aria-hidden="true">↗</span></a>
							<a href={cvHref} class="hero-action" download>Download CV <span aria-hidden="true">↓</span></a>
							<a href="https://github.com/AlexMollard" target="_blank" rel="noreferrer" class="hero-action">GitHub <span aria-hidden="true">↗</span></a>
							<a href="https://au.linkedin.com/in/alex-mollard" target="_blank" rel="noreferrer" class="hero-action">LinkedIn <span aria-hidden="true">↗</span></a>
						</div>
					</div>

					<div class="hero-board soft-panel overflow-hidden border border-line bg-surface">
						<div class="border-b border-line bg-raised p-4">
							<p class="mono text-[9px] uppercase tracking-[0.14em] text-signal">Production engineering</p>
							<ul class="mt-3 space-y-2 text-sm leading-relaxed text-paper">
								<li><a href="#cricket-26" class="underline decoration-signal underline-offset-4">WebSocket/TLS networking shipped on PC, PlayStation and Xbox</a></li>
								<li><a href={withBase('/projects/bigant-diagnostics/', import.meta.env.BASE_URL)} class="underline decoration-signal underline-offset-4">Crash diagnostics and developer workflow automation</a></li>
								<li><a href={withBase('/projects/anthill/', import.meta.env.BASE_URL)} class="underline decoration-signal underline-offset-4">AntHill — studio asset management, in development</a></li>
							</ul>
						</div>
						<div class="flex items-center justify-between gap-4 border-b border-line px-4 py-3">
							<p class="mono text-[9px] uppercase tracking-[0.14em] text-muted">Shipped at Big Ant Studios</p>
							<p class="mono text-[9px] uppercase tracking-[0.14em] text-signal">{String(shippedTitleCount).padStart(2, '0')}</p>
						</div>
						<ul class="hero-shipped">
							{shippedTitles.map(({ project, year }, index) => (
								<li class="hero-shipped-tile">
									{project.data.media_images?.[0] && (
										<img
											src={withBase(project.data.media_images[0], import.meta.env.BASE_URL)}
											alt={`${project.data.title} screenshot`}
											loading={index < 4 ? 'eager' : 'lazy'}
										/>
									)}
									<span class="hero-shipped-label">
										<span class="truncate text-paper">{project.data.title}</span>
										<span>{year}</span>
									</span>
								</li>
							))}
						</ul>
						<div class="hero-board-aside grid gap-3 border-t border-line bg-raised p-4 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-end">
							<div>
								<p class="mono text-[9px] uppercase tracking-[0.14em] text-cool">Outside work / applications and agent tooling</p>
								<p class="mt-1.5 text-sm leading-relaxed text-muted"><span class="text-paper">Ironvellum</span> - an offline-first Android application. <span class="text-paper">AetherCore</span> - an engine with MCP tools for live inspection and validation.</p>
							</div>
							<a href={withBase('/projects/ironvellum/', import.meta.env.BASE_URL)} class="mono shrink-0 text-[10px] uppercase tracking-[0.14em] text-paper underline decoration-signal underline-offset-4">Read case study</a>
						</div>
					</div>
				</div>

				<div class="hero-facts grid gap-px border border-line bg-line sm:grid-cols-3">
					<div class="bg-ground p-4"><p class="mono text-[9px] uppercase tracking-[0.12em] text-muted">Now</p><p class="mt-1 text-sm text-paper">Senior Generalist Programmer, Big Ant Studios</p></div>
					<div class="bg-ground p-4"><p class="mono text-[9px] uppercase tracking-[0.12em] text-muted">Shipped</p><p class="mt-1 text-sm text-paper">{shippedTitleCount} console and PC titles since {shippedSinceYear}</p></div>
					<div class="bg-ground p-4"><p class="mono text-[9px] uppercase tracking-[0.12em] text-muted">Core</p><p class="mt-1 text-sm text-paper">C++ · C# · networking · developer tools</p></div>
				</div>
			</div>
		</section>
	</header>

	<main class="relative left-1/2 -mx-[50dvw] w-[100dvw] px-6 py-20 md:px-10 md:py-28 lg:px-14">
		<div class="mx-auto max-w-[104rem]">
			<section id="selected-work" class="scroll-mt-8">
				<header class="section-rule mb-12 grid gap-6 lg:grid-cols-[18rem_minmax(0,1fr)] lg:items-end">
					<p class="mono text-[10px] uppercase tracking-[0.16em] text-muted">Selected work / {spotlightProjects.length} case studies</p>
					<div class="grid gap-5 md:grid-cols-[minmax(0,1fr)_minmax(18rem,0.65fr)] md:items-end">
						<h2 class="text-5xl font-medium leading-none text-paper md:text-7xl">Selected<br /> projects.</h2>
						<p class="max-w-xl text-base leading-relaxed text-muted">{spotlightProjects.length} projects with more detail on my role, the technical problems, and the result.</p>
					</div>
				</header>

				<div class="spotlight-grid grid gap-5 lg:grid-cols-2">
					{spotlightProjects.map(({ project, domain, year }, projectIndex) => {
						const previewImage = project.data.media_images?.[0];
						const slug = project.id;

						return (
							<article id={slug} class="spotlight-card relative soft-panel card-pop overflow-hidden border border-line bg-surface" data-project-card>
								<ProjectGallery title={project.data.title} images={project.data.media_images} card previewHref={withBase(`/projects/${project.id}/`, import.meta.env.BASE_URL)} />

								<div class="project-card-copy p-5 md:p-6">
									<div class="flex items-start justify-between gap-4">
										<div class="flex flex-wrap gap-2">
											<span class="meta-chip">{domain}</span>
											{project.data.api && <span class="meta-chip">{project.data.api}</span>}
											<span class="meta-chip">{year}</span>
											{project.data.build_mode === 'Agent-directed' && <span class="meta-chip build-chip">Agent-directed</span>}
										</div>
										<p class="mono shrink-0 text-[10px] tracking-[0.12em] text-signal">/{String(projectIndex + 1).padStart(2, '0')}</p>
									</div>
									<h3 class="mt-5 text-3xl font-semibold leading-tight text-paper md:text-4xl"><a href={withBase(`/projects/${project.id}/`, import.meta.env.BASE_URL)} data-preview-link class="after:absolute after:inset-0">{project.data.title}</a></h3>
									<p class="mt-3 text-sm leading-relaxed text-muted md:text-base">{project.data.summary}</p>
									{project.data.outcomes.length > 0 && (
										<ul class="spotlight-outcomes mt-5 space-y-2">
											{project.data.outcomes.slice(0, 1).map((outcome) => <li>{outcome}</li>)}
										</ul>
									)}
									<div class="project-card-actions mt-6 flex flex-wrap gap-3">
                                        <a href={withBase(`/projects/${project.id}/`, import.meta.env.BASE_URL)} class="relative z-10 case-study-direct"><span class="case-study-label">Full case study</span><span aria-hidden="true">→</span></a>
									</div>
								</div>
								<ProjectPreview project={project} />
							</article>
						);
					})}
				</div>
			</section>

			<section id="how-i-work" class="scroll-mt-8 pt-24 md:pt-32">
				<header class="section-rule mb-10 grid gap-6 lg:grid-cols-[18rem_minmax(0,1fr)] lg:items-end">
					<p class="mono text-[10px] uppercase tracking-[0.16em] text-muted">Engineering workflow</p>
					<div class="grid gap-5 md:grid-cols-[minmax(0,1fr)_minmax(18rem,0.65fr)] md:items-end">
						<h2 class="text-5xl font-medium leading-none text-paper md:text-7xl">How the<br /> work happens.</h2>
						<p class="max-w-xl text-base leading-relaxed text-muted">I use Oh my PI extensively across multiple AI providers, alongside Claude Code. In my personal projects, I define requirements, divide implementation work, review changes and validate behaviour before integration.</p>
					</div>
				</header>

				<div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
					<article class="soft-panel card-glow border-1 border-line bg-surface p-5 md:p-6">
						<p class="mono text-[10px] uppercase tracking-[0.14em] text-signal">Design</p>
						<p class="mt-3 text-lg leading-snug text-paper">I decide the architecture.</p>
						<p class="mt-2 text-sm leading-relaxed text-muted">I define requirements, acceptance criteria and subsystem boundaries. In AetherCore that includes GPU abstractions; in Ironvellum it includes offline storage and cloud backup.</p>
					</article>
					<article class="soft-panel card-glow border-1 border-line bg-surface p-5 md:p-6">
						<p class="mono text-[10px] uppercase tracking-[0.14em] text-signal">Verification</p>
						<p class="mt-3 text-lg leading-snug text-paper">Tests, checks and review before integration.</p>
						<p class="mt-2 text-sm leading-relaxed text-muted">Automated tests exercise engine subsystems. Static architecture checks and a GPU abstraction guard check boundaries; local GPU smoke tests exercise the editor and runtime.</p>
					</article>
					<article class="soft-panel card-glow border-1 border-line bg-surface p-5 md:p-6">
						<p class="mono text-[10px] uppercase tracking-[0.14em] text-signal">Implementation</p>
						<p class="mt-3 text-lg leading-snug text-paper">Split implementation into bounded tasks.</p>
						<p class="mt-2 text-sm leading-relaxed text-muted">I use Oh my PI (omp) with multiple AI providers and Claude Code to work on bounded implementation tasks, then review changes against the design and acceptance criteria.</p>
					</article>
					<article class="soft-panel card-glow border-1 border-line bg-surface p-5 md:p-6">
						<p class="mono text-[10px] uppercase tracking-[0.14em] text-signal">MCP / Runtime inspection</p>
						<p class="mt-3 text-lg leading-snug text-paper">Give agents access to running software.</p>
						<p class="mt-2 text-sm leading-relaxed text-muted">AetherCore's MCP interface lets agents inspect and control the live editor, capture screenshots and run validation with structured results.</p>
					</article>
					<article class="soft-panel card-glow border-1 border-line bg-surface p-5 md:p-6">
						<p class="mono text-[10px] uppercase tracking-[0.14em] text-signal">Big Ant / Tools for teammates</p>
						<p class="mt-3 text-lg leading-snug text-paper">I build what they asked for.</p>
						<p class="mt-2 text-sm leading-relaxed text-muted">I work with programmers and QA on new systems and improvements to established tools. Internal documentation is agent-assisted and peer-reviewed.</p>
					</article>
					<article class="soft-panel card-glow border-1 border-line bg-surface p-5 md:p-6">
						<p class="mono text-[10px] uppercase tracking-[0.14em] text-signal">Big Ant / Release support</p>
						<p class="mt-3 text-lg leading-snug text-paper">I help the team resolve release blockers.</p>
						<p class="mt-2 text-sm leading-relaxed text-muted">Near submission I work with producers and other programmers to resolve certification issues, cover gaps and stabilise integrations for release.</p>
					</article>
				</div>
			</section>

			<section id="archive" class="scroll-mt-8 pt-24 md:pt-32">
			<header class="section-rule mb-12 grid gap-6 lg:grid-cols-[18rem_minmax(0,1fr)] lg:items-end">
				<p class="mono text-[10px] uppercase tracking-[0.16em] text-muted">Work archive / {atlasProjects.length} entries</p>
				<div class="grid gap-5 md:grid-cols-[minmax(0,1fr)_minmax(18rem,0.65fr)] md:items-end">
					<h2 class="text-5xl font-medium leading-none text-paper md:text-7xl">All<br /> projects.</h2>
					<p class="max-w-xl text-base leading-relaxed text-muted">Professional work, personal engines, experiments, and smaller tools.</p>
				</div>
			</header>

			<section class="grid gap-6 lg:grid-cols-[18rem_minmax(0,1fr)]">
				<aside class="soft-panel h-fit border-1 border-line bg-surface p-4 md:p-5 lg:sticky lg:top-6">
					<div class="flex items-center justify-between gap-3 lg:hidden">
						<div>
							<p class="mono text-[11px] uppercase tracking-[0.14em] text-muted">Project index</p>
							<p class="mt-1 text-sm text-muted">Filter the archive</p>
						</div>
						<button id="atlas-filters-toggle" type="button" class="atlas-chip shrink-0" aria-expanded="false" aria-controls="atlas-filters-panel">Show Filters</button>
					</div>
					<div id="atlas-filters-panel" class="mt-4 hidden space-y-4 lg:mt-0 lg:block">
						<div>
							<label for="atlas-search" class="mono text-[11px] uppercase tracking-[0.14em] text-muted">Search</label>
							<input id="atlas-search" type="text" placeholder="project, technology, workflow" class="mt-2 w-full border-1 border-line bg-ground px-3 py-2 text-sm text-paper placeholder:text-muted focus:border-signal" />
						</div>

						<div>
							<p class="mono text-[11px] uppercase tracking-[0.14em] text-muted">Sort</p>
							<select id="atlas-sort" class="atlas-select mt-2 w-full border-1 border-line bg-ground px-3 py-2 text-sm text-paper focus:border-signal">
								<option value="newest">Newest</option>
								<option value="oldest">Oldest</option>
								<option value="title">Title A-Z</option>
							</select>
						</div>

						<div>
							<p class="mono text-[11px] uppercase tracking-[0.14em] text-muted">Domain</p>
							<div class="mt-2 flex flex-wrap gap-2" data-filter-group="domain">
								<button class="atlas-chip atlas-chip-active" data-filter="all" type="button">All</button>
								{domains.map((domain) => <button class="atlas-chip" data-filter={domain} type="button">{domain}</button>)}
							</div>
						</div>

						<div>
							<p class="mono text-[11px] uppercase tracking-[0.14em] text-muted">Type</p>
							<div class="mt-2 flex flex-wrap gap-2" data-filter-group="category">
								<button class="atlas-chip atlas-chip-active" data-filter="all" type="button">All</button>
								{categories.map((category) => <button class="atlas-chip" data-filter={category} type="button">{category}</button>)}
							</div>
						</div>

						<div>
							<p class="mono text-[11px] uppercase tracking-[0.14em] text-muted">Graphics API</p>
							<div class="mt-2 flex flex-wrap gap-2" data-filter-group="api">
								<button class="atlas-chip atlas-chip-active" data-filter="all" type="button">All</button>
								{apis.map((api) => <button class="atlas-chip" data-filter={api} type="button">{api}</button>)}
							</div>
						</div>

						<div>
							<p class="mono text-[11px] uppercase tracking-[0.14em] text-muted">Timeline</p>
							<div class="mt-2 flex flex-wrap gap-2" data-filter-group="year">
								<button class="atlas-chip atlas-chip-active" data-filter="all" type="button">All</button>
								{years.map((year) => <button class="atlas-chip" data-filter={String(year)} type="button">{year}</button>)}
							</div>
						</div>

						<button id="atlas-reset" type="button" class="atlas-chip w-full">Reset Filters</button>
					</div>
				</aside>

				<div class="space-y-5">
					<div id="atlas-grid" class="grid gap-5 xl:grid-cols-2">
						{atlasProjects.map(({ project, domain, year }, projectIndex) => {
							const previewImage = project.data.media_images?.[0];

							return (
								<article
									class="atlas-card relative soft-panel card-pop overflow-hidden border-1 border-line bg-surface"
									data-project-card
									data-title={project.data.title.toLowerCase()}
									data-summary={project.data.summary.toLowerCase()}
									data-features={[project.data.engine, ...project.data.features, project.data.build_note ?? ''].join(' ').toLowerCase()}
									data-domain={domain}
									data-category={project.data.category}
									data-api={project.data.api ?? ''}
									data-year={String(year)}
									data-ts={String(project.data.date.getTime())}
								>
									<ProjectGallery title={project.data.title} images={project.data.media_images} card previewHref={withBase(`/projects/${project.id}/`, import.meta.env.BASE_URL)} />
									<div class="project-card-copy space-y-3 p-5">
										<div class="flex items-start justify-between gap-3">
											<div class="flex flex-wrap items-center gap-2">
												<span class="meta-chip">{domain}</span>
												{project.data.api && <span class="meta-chip">{project.data.api}</span>}
												<span class="meta-chip">{project.data.category}</span>
												<span class="meta-chip">{year}</span>
												{project.data.build_mode === 'Agent-directed' && <span class="meta-chip build-chip">Agent-directed</span>}
											</div>
											<p class="mono shrink-0 text-[10px] tracking-[0.12em] text-signal">/{String(projectIndex + 1).padStart(2, '0')}</p>
										</div>
										<h3 class="text-2xl font-semibold leading-tight text-paper"><a href={withBase(`/projects/${project.id}/`, import.meta.env.BASE_URL)} data-preview-link class="after:absolute after:inset-0">{project.data.title}</a></h3>
										<p class="text-sm leading-relaxed text-muted">{project.data.summary}</p>
										<div class="project-card-actions">
											<div class="flex flex-wrap items-center gap-2">
                                        <a href={withBase(`/projects/${project.id}/`, import.meta.env.BASE_URL)} class="relative z-10 case-study-direct"><span class="case-study-label">Full case study</span><span aria-hidden="true">→</span></a>
											</div>
										</div>
									</div>
								<ProjectPreview project={project} />
								</article>
							);
						})}
					</div>

					<div class="flex flex-wrap items-center justify-between gap-4">
						<p id="atlas-empty" class="hidden text-sm text-muted">
							No projects match the current filter set.
							<button id="atlas-empty-reset" type="button" class="ml-2 underline decoration-signal underline-offset-4 hover:text-paper">Reset filters</button>
						</p>
						<button id="atlas-load-more" type="button" class="atlas-chip">Load More</button>
					</div>
				</div>
			</section>
			</section>

		</div>

    <dialog id="project-preview" aria-labelledby="project-preview-title" class="m-auto max-h-[90dvh] overflow-hidden rounded-sm border border-line bg-surface p-0 text-paper shadow-2xl">
      <form method="dialog" class="absolute right-3 top-3 z-20">
        <button class="atlas-chip flex h-11 w-11 items-center justify-center text-xl" autofocus aria-label="Close project preview">×</button>
      </form>
      <div id="project-preview-content"></div>
    </dialog>
    <style>
  .case-study-direct { display: inline-flex; align-items: center; gap: .65rem; min-height: 44px; padding: .35rem 0; color: var(--color-paper); font-size: .9rem; font-weight: 500; text-decoration: none; }
  .case-study-direct [aria-hidden] { color: var(--color-signal); }
  .case-study-direct .case-study-label { border-bottom: 1px solid var(--color-line); padding-bottom: .2rem; }
  .spotlight-card, .atlas-card:not(.atlas-card-hidden) { display: flex; flex-direction: column; }
  .project-card-copy { display: flex; flex: 1; flex-direction: column; align-items: flex-start; }
  .project-card-actions { margin-top: auto !important; padding-top: 1.25rem; width: 100%; }
  .project-card-copy > .flex { width: 100%; }
  @media (min-width: 1100px) { #atlas-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .case-study-direct:hover .case-study-label { border-color: var(--color-signal); }
  .case-study-direct:focus-visible { outline: 2px solid var(--color-signal); outline-offset: 4px; }
      #project-preview { width: min(42rem, calc(100% - 2rem)); overscroll-behavior: contain; scrollbar-gutter: auto; }
      #project-preview[data-has-image="true"] { width: min(60rem, calc(100% - 2rem)); }
      #project-preview::backdrop { background: rgb(0 0 0 / 70%); }
    </style>

		<script>import '../scripts/project-gallery';</script>
		<script is:inline>
			(() => {
        const preview = document.getElementById('project-preview');
        const previewContent = document.getElementById('project-preview-content');
        let previousOverflow = '';
        document.addEventListener('click', (event) => {
          const link = event.target.closest('[data-preview-link]');
          if (!link || event.ctrlKey || event.metaKey || event.shiftKey || event.altKey || event.button !== 0) return;
          const template = link.closest('[data-project-card]')?.querySelector('[data-project-preview]');
          if (!template || !preview || !previewContent) return;
          event.preventDefault();
          previewContent.replaceChildren(template.content.cloneNode(true));
          previousOverflow = document.documentElement.style.overflow;
          document.documentElement.style.overflow = 'hidden';
          preview.dataset.hasImage = template.dataset.hasImage;
          preview.showModal();
          preview.scrollTop = 0;
        });
        preview?.addEventListener('close', () => {
          document.documentElement.style.overflow = previousOverflow;
          previewContent.replaceChildren();
        });
        preview?.addEventListener('click', (event) => {
          if (event.target !== preview) return;
          const rect = preview.getBoundingClientRect();
          if (event.clientX < rect.left || event.clientX > rect.right || event.clientY < rect.top || event.clientY > rect.bottom) preview.close();
        });
				const cards = Array.from(document.querySelectorAll('#atlas-grid .atlas-card'));
				const searchInput = document.getElementById('atlas-search');
				const sortSelect = document.getElementById('atlas-sort');
				const emptyState = document.getElementById('atlas-empty');
				const loadMoreButton = document.getElementById('atlas-load-more');
				const resetButton = document.getElementById('atlas-reset');
				const filtersToggle = document.getElementById('atlas-filters-toggle');
				const filtersPanel = document.getElementById('atlas-filters-panel');
				const groups = Array.from(document.querySelectorAll('[data-filter-group]'));

				if (!cards.length || !searchInput || !sortSelect || !emptyState || !loadMoreButton || !resetButton) return;

				const state = {
					search: '',
					domain: 'all',
					category: 'all',
					api: 'all',
					year: 'all',
					sort: 'newest',
					limit: 6
				};

				const allowedValues = (groupName) => {
					const group = groups.find((node) => node.getAttribute('data-filter-group') === groupName);
					if (!group) return [];
					return Array.from(group.querySelectorAll('.atlas-chip')).map((chip) => chip.getAttribute('data-filter'));
				};

				const params = new URLSearchParams(window.location.search);
				(['domain', 'category', 'api', 'year']).forEach((key) => {
					const value = params.get(key);
					if (value && allowedValues(key).includes(value)) state[key] = value;
				});
				const sortParam = params.get('sort');
				if (sortParam && Array.from(sortSelect.options).some((option) => option.value === sortParam)) {
					state.sort = sortParam;
				}
				const searchParam = params.get('search');
				if (searchParam) state.search = searchParam;

				searchInput.value = state.search;
				sortSelect.value = state.sort;

				const syncFiltersVisibility = () => {
					if (!filtersToggle || !filtersPanel) return;
					const isDesktop = window.matchMedia('(min-width: 1024px)').matches;
					const isOpen = isDesktop || !filtersPanel.classList.contains('hidden');
					filtersToggle.setAttribute('aria-expanded', String(isOpen));
					filtersToggle.textContent = isOpen ? 'Hide Filters' : 'Show Filters';
				};

				if (filtersToggle && filtersPanel) {
					filtersToggle.addEventListener('click', () => {
						if (window.matchMedia('(min-width: 1024px)').matches) return;
						filtersPanel.classList.toggle('hidden');
						syncFiltersVisibility();
					});

					window.addEventListener('resize', syncFiltersVisibility);
					syncFiltersVisibility();
				}

				const setActiveChip = (groupName, value) => {
					const group = groups.find((node) => node.getAttribute('data-filter-group') === groupName);
					if (!group) return;
					group.querySelectorAll('.atlas-chip').forEach((chip) => {
						const isActive = chip.getAttribute('data-filter') === value;
						chip.classList.toggle('atlas-chip-active', isActive);
						chip.setAttribute('aria-pressed', String(isActive));
					});
				};

				const updateURL = () => {
					const nextParams = new URLSearchParams();
					if (state.search) nextParams.set('search', state.search);
					if (state.domain !== 'all') nextParams.set('domain', state.domain);
					if (state.category !== 'all') nextParams.set('category', state.category);
					if (state.api !== 'all') nextParams.set('api', state.api);
					if (state.year !== 'all') nextParams.set('year', state.year);
					if (state.sort !== 'newest') nextParams.set('sort', state.sort);
					const query = nextParams.toString();
					window.history.replaceState({}, '', `${window.location.pathname}${query ? `?${query}` : ''}${window.location.hash}`);
				};

				const apply = () => {
					const search = state.search.trim().toLowerCase();
					const filtered = cards.filter((card) => {
						const haystack = `${card.dataset.title} ${card.dataset.summary} ${card.dataset.features}`;
						const matchesSearch = !search || haystack.includes(search);
						const matchesDomain = state.domain === 'all' || card.dataset.domain === state.domain;
						const matchesCategory = state.category === 'all' || card.dataset.category === state.category;
						const matchesApi = state.api === 'all' || card.dataset.api === state.api;
						const matchesYear = state.year === 'all' || card.dataset.year === state.year;
						return matchesSearch && matchesDomain && matchesCategory && matchesApi && matchesYear;
					});

					filtered.sort((a, b) => {
						if (state.sort === 'title') return (a.dataset.title || '').localeCompare(b.dataset.title || '');
						const delta = Number(b.dataset.ts || 0) - Number(a.dataset.ts || 0);
						return state.sort === 'oldest' ? -delta : delta;
					});

					cards.forEach((card) => card.classList.add('atlas-card-hidden'));
					filtered.forEach((card, index) => {
						card.classList.toggle('atlas-card-hidden', index >= state.limit);
					});

					emptyState.classList.toggle('hidden', filtered.length > 0);
					loadMoreButton.classList.toggle('hidden', filtered.length <= state.limit);

					const grid = document.getElementById('atlas-grid');
					if (grid) {
						filtered.forEach((card) => grid.appendChild(card));
					}

					updateURL();
					setupInfiniteScroll();
				};

				groups.forEach((group) => {
					const key = group.getAttribute('data-filter-group');
					if (!key) return;
					setActiveChip(key, state[key]);
					group.querySelectorAll('.atlas-chip').forEach((chip) => {
						chip.addEventListener('click', () => {
							state[key] = chip.getAttribute('data-filter') || 'all';
							state.limit = 6;
							setActiveChip(key, state[key]);
							apply();
						});
					});
				});

				searchInput.addEventListener('input', (event) => {
					state.search = event.target.value;
					state.limit = 6;
					apply();
				});

				sortSelect.addEventListener('change', (event) => {
					state.sort = event.target.value;
					apply();
				});

				loadMoreButton.addEventListener('click', () => {
					state.limit += 6;
					apply();
				});

				const resetFilters = () => {
					state.search = '';
					state.domain = 'all';
					state.category = 'all';
					state.api = 'all';
					state.year = 'all';
					state.sort = 'newest';
					state.limit = 6;
					searchInput.value = '';
					sortSelect.value = 'newest';
					setActiveChip('domain', 'all');
					setActiveChip('category', 'all');
					setActiveChip('api', 'all');
					setActiveChip('year', 'all');
					apply();
				};

				resetButton.addEventListener('click', resetFilters);
				document.getElementById('atlas-empty-reset')?.addEventListener('click', resetFilters);

				// Infinite scroll: one sentinel, one observer, reused across every filter change.
				const setupInfiniteScroll = () => {
					const grid = document.getElementById('atlas-grid');
					if (!grid || document.getElementById('atlas-scroll-sentinel')) return;

					const sentinel = document.createElement('div');
					sentinel.id = 'atlas-scroll-sentinel';
					grid.parentNode?.insertBefore(sentinel, grid.nextSibling);

					const observer = new IntersectionObserver((entries) => {
						entries.forEach((entry) => {
							if (entry.isIntersecting && !loadMoreButton.classList.contains('hidden')) {
								state.limit += 6;
								apply();
							}
						});
					}, { rootMargin: '200px' });

					observer.observe(sentinel);
				};

				apply();
			})();
		</script>
	</main>

