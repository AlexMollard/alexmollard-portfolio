---
import { getCollection, render } from 'astro:content';
import ProjectCaseStudy from '../components/ProjectCaseStudy.astro';
import Layout from '../layouts/Layout.astro';
import { withBase } from '../utils/withBase';

const projects = (await getCollection('projects')).sort((a, b) => {
	const byDate = b.data.date.getTime() - a.data.date.getTime();
	return byDate !== 0 ? byDate : a.data.title.localeCompare(b.data.title);
});

const atlasProjects = await Promise.all(
	projects.map(async (project) => {
		const { Content } = await render(project);

		return {
			project,
			domain: project.data.domain,
			year: project.data.date.getFullYear(),
			Content
		};
	})
);

const shippedTitles = atlasProjects.filter(
	(item) => item.project.data.category === 'Professional' && item.domain !== 'Tools'
);
const shippedTitleCount = shippedTitles.length;
const shippedSinceYear = Math.min(...shippedTitles.map((item) => item.year));
const agentDirectedCount = atlasProjects.filter((item) => item.project.data.build_mode === 'Agent-directed').length;

const cvHref = withBase('/alex-mollard-cv.pdf', import.meta.env.BASE_URL);
const domains = [...new Set(atlasProjects.map((item) => item.domain))].sort();
const categories = [...new Set(atlasProjects.map((item) => item.project.data.category))];
const apis = [...new Set(atlasProjects.map((item) => item.project.data.api).filter(Boolean))].sort();
const years = [...new Set(atlasProjects.map((item) => item.year))].sort((a, b) => b - a);
const spotlightProjects = atlasProjects
	.filter((item) => item.project.data.spotlight_order !== undefined)
	.sort((a, b) => (a.project.data.spotlight_order ?? 999) - (b.project.data.spotlight_order ?? 999));
---

	<Layout
		title="Alex Mollard | Senior Generalist Programmer"
		description="Senior Generalist Programmer at Big Ant Studios in Melbourne. Eight shipped console and PC titles, plus AetherCore, a Vulkan engine with an editor, C# scripting, and owner-authoritative netcode."
>
	<header id="top" class="reveal-in relative left-1/2 -mx-[50dvw] -mt-10 w-[100dvw] md:-mt-14">
		<section class="hero-stage w-[100dvw] px-6 pb-12 pt-8 sm:px-10 md:pb-16 md:pt-10 lg:px-14">
			<div class="mx-auto max-w-[104rem]">
				<nav class="hero-nav flex flex-wrap items-center justify-between gap-4 border-b border-line pb-4" aria-label="Primary navigation">
					<a href="#top" class="mono text-[10px] uppercase tracking-[0.16em] text-paper">Alex Mollard / Portfolio</a>
					<div class="flex flex-wrap items-center gap-x-5 gap-y-2">
						<a href="#how-i-work" class="hero-nav-link">How I work</a>
						<a href="#selected-work" class="hero-nav-link">Selected work</a>
						<a href="#archive" class="hero-nav-link">Archive</a>
						<a href="https://github.com/AlexMollard" target="_blank" rel="noreferrer" class="hero-nav-link">GitHub ↗</a>
					</div>
				</nav>

				<div class="hero-layout grid gap-10 py-14 md:py-18 lg:grid-cols-[minmax(0,0.92fr)_minmax(30rem,1.08fr)] lg:items-end lg:gap-16 lg:py-20">
					<div class="hero-intro max-w-3xl">
						<p class="mono text-[11px] uppercase tracking-[0.16em] text-signal">Senior Generalist Programmer · Big Ant Studios · Melbourne</p>
						<h1 class="mt-6 text-[clamp(4.1rem,8vw,8.8rem)] font-medium leading-[0.8] text-paper">
							Alex<br />Mollard
						</h1>
						<p class="mt-9 max-w-2xl text-lg leading-relaxed text-muted md:text-[1.35rem]">
							I build the systems a game is made of — Vulkan rendering, engine architecture, netcode, and the tools the rest of the team works in.
						</p>
						<div class="mt-8 flex flex-wrap gap-3">
							<a href="mailto:alexmollard@protonmail.com" class="hero-action hero-action-primary">Email me <span aria-hidden="true">↗</span></a>
							<a href={cvHref} class="hero-action" download>Download CV <span aria-hidden="true">↓</span></a>
							<a href="#selected-work" class="hero-action">Selected work <span aria-hidden="true">↓</span></a>
							<a href="https://au.linkedin.com/in/alex-mollard" target="_blank" rel="noreferrer" class="hero-action">LinkedIn <span aria-hidden="true">↗</span></a>
						</div>
					</div>

					<div class="hero-board soft-panel overflow-hidden border border-line bg-surface">
						<div class="flex items-center justify-between gap-4 border-b border-line px-4 py-3">
							<p class="mono text-[9px] uppercase tracking-[0.14em] text-muted">Shipped titles</p>
							<p class="mono text-[9px] uppercase tracking-[0.14em] text-signal">{String(shippedTitleCount).padStart(2, '0')}</p>
						</div>
						<ul class="hero-shipped">
							{shippedTitles.map(({ project, year }, index) => (
								<li class="hero-shipped-tile">
									{project.data.media_images?.[0] && (
										<img
											src={withBase(project.data.media_images[0], import.meta.env.BASE_URL)}
											alt={`${project.data.title} screenshot`}
											loading={index < 4 ? 'eager' : 'lazy'}
										/>
									)}
									<span class="hero-shipped-label">
										<span class="truncate text-paper">{project.data.title}</span>
										<span>{year}</span>
									</span>
								</li>
							))}
						</ul>
						<div class="grid gap-3 border-t border-line p-4 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-end">
							<div>
								<p class="mono text-[9px] uppercase tracking-[0.14em] text-signal">Current personal work</p>
								<p class="mt-1.5 text-sm leading-relaxed text-muted"><span class="text-paper">AetherCore</span> - a Vulkan engine with an editor, hot-reloadable C# gameplay, and owner-authoritative netcode.</p>
							</div>
							<a href="#aethercore" class="mono shrink-0 text-[10px] uppercase tracking-[0.14em] text-paper underline decoration-signal underline-offset-4">Read case study</a>
						</div>
					</div>
				</div>

				<div class="hero-facts grid gap-px border border-line bg-line sm:grid-cols-3">
					<div class="bg-ground p-4"><p class="mono text-[9px] uppercase tracking-[0.12em] text-muted">Now</p><p class="mt-1 text-sm text-paper">Senior Generalist Programmer, Big Ant Studios</p></div>
					<div class="bg-ground p-4"><p class="mono text-[9px] uppercase tracking-[0.12em] text-muted">Shipped</p><p class="mt-1 text-sm text-paper">{shippedTitleCount} console and PC titles since {shippedSinceYear}</p></div>
					<div class="bg-ground p-4"><p class="mono text-[9px] uppercase tracking-[0.12em] text-muted">Core</p><p class="mt-1 text-sm text-paper">C++ · Vulkan · C# · engine tooling</p></div>
				</div>
			</div>
		</section>
	</header>

	<main class="relative left-1/2 -mx-[50dvw] w-[100dvw] px-6 py-20 md:px-10 md:py-28 lg:px-14">
		<div class="mx-auto max-w-[104rem]">
			<section id="how-i-work" class="scroll-mt-8 pb-24 md:pb-32">
				<header class="section-rule mb-10 grid gap-6 lg:grid-cols-[18rem_minmax(0,1fr)] lg:items-end">
					<p class="mono text-[10px] uppercase tracking-[0.16em] text-muted">How I work / {agentDirectedCount} agent-directed projects</p>
					<div class="grid gap-5 md:grid-cols-[minmax(0,1fr)_minmax(18rem,0.65fr)] md:items-end">
						<h2 class="text-5xl font-medium leading-none text-paper md:text-7xl">Directing<br /> agent work.</h2>
						<p class="max-w-xl text-base leading-relaxed text-muted">I architect and review; multi-model agent harnesses do most of the typing. Projects built that way carry an <span class="text-paper">Agent-directed</span> label below - I am not going to pretend otherwise.</p>
					</div>
				</header>

				<div class="grid gap-5 lg:grid-cols-3">
					<article class="soft-panel border-1 border-line bg-surface p-5 md:p-6">
						<p class="mono text-[10px] uppercase tracking-[0.14em] text-signal">Design and constraints</p>
						<p class="mt-3 text-sm leading-relaxed text-muted">I decide the architecture, the boundaries between systems, and the acceptance criteria before any agent runs. AetherCore's engine-facing GPU abstraction, its immutable render packets, and its owner-authoritative netcode model are design calls, not generated ones.</p>
					</article>
					<article class="soft-panel border-1 border-line bg-surface p-5 md:p-6">
						<p class="mono text-[10px] uppercase tracking-[0.14em] text-signal">Verification floor</p>
						<p class="mt-3 text-sm leading-relaxed text-muted">Agent output only counts once it survives a gate. AetherCore keeps 1,271 automated tests across 152 suites, an automated guard that fails the build when engine code reaches past the GPU abstraction, and CI architecture checks on every push. Nothing merges on vibes.</p>
					</article>
					<article class="soft-panel border-1 border-line bg-surface p-5 md:p-6">
						<p class="mono text-[10px] uppercase tracking-[0.14em] text-signal">Throughput</p>
						<p class="mt-3 text-sm leading-relaxed text-muted">Running several models in parallel through harnesses like omp and Claude Code, with work split so agents do not collide, turns subsystems that used to take weeks into days. A solo engine of this size is only tractable because of it.</p>
					</article>
				</div>
			</section>

			<section id="selected-work" class="scroll-mt-8">
				<header class="section-rule mb-12 grid gap-6 lg:grid-cols-[18rem_minmax(0,1fr)] lg:items-end">
					<p class="mono text-[10px] uppercase tracking-[0.16em] text-muted">Selected work / {spotlightProjects.length} case studies</p>
					<div class="grid gap-5 md:grid-cols-[minmax(0,1fr)_minmax(18rem,0.65fr)] md:items-end">
						<h2 class="text-5xl font-medium leading-none text-paper md:text-7xl">Selected<br /> projects.</h2>
						<p class="max-w-xl text-base leading-relaxed text-muted">{spotlightProjects.length} projects with more detail on my role, the technical problems, and the result.</p>
					</div>
				</header>

				<div class="spotlight-grid grid gap-5 lg:grid-cols-2">
					{spotlightProjects.map(({ project, domain, year, Content }, projectIndex) => {
						const previewImage = project.data.media_images?.[0];
						const slug = project.id;

						return (
							<article id={slug} class="spotlight-card soft-panel card-pop overflow-hidden border border-line bg-surface" data-project-card>
								{previewImage ? (
									<div class="spotlight-media overflow-hidden border-b border-line">
										<img src={withBase(previewImage, import.meta.env.BASE_URL)} alt={`${project.data.title} preview`} class="h-full w-full object-cover" loading={projectIndex === 0 ? 'eager' : 'lazy'} />
									</div>
								) : (
									<div class="spotlight-placeholder border-b border-line p-5">
										<span class="mono text-[10px] uppercase tracking-[0.14em] text-muted">Internal tools / production systems</span>
									</div>
								)}

								<div class="p-5 md:p-6">
									<div class="flex items-start justify-between gap-4">
										<div class="flex flex-wrap gap-2">
											<span class="meta-chip">{domain}</span>
											{project.data.api && <span class="meta-chip">{project.data.api}</span>}
											<span class="meta-chip">{year}</span>
											{project.data.build_mode === 'Agent-directed' && <span class="meta-chip build-chip">Agent-directed</span>}
										</div>
										<p class="mono shrink-0 text-[10px] tracking-[0.12em] text-signal">/{String(projectIndex + 1).padStart(2, '0')}</p>
									</div>
									<h3 class="mt-5 text-3xl font-semibold leading-tight text-paper md:text-4xl">{project.data.title}</h3>
									<p class="mt-3 text-sm leading-relaxed text-muted md:text-base">{project.data.summary}</p>
									{project.data.role && <p class="mt-4 text-sm leading-relaxed text-paper"><span class="mono mr-2 text-[9px] uppercase tracking-[0.12em] text-signal">Role</span> {project.data.role}</p>}
									{project.data.outcomes.length > 0 && (
										<ul class="spotlight-outcomes mt-5 space-y-2">
											{project.data.outcomes.slice(0, 2).map((outcome) => <li>{outcome}</li>)}
										</ul>
									)}
									<button type="button" class="case-study-toggle atlas-chip mt-6" aria-expanded="false" data-closed-label="Read case study">Read case study</button>
								</div>

								<ProjectCaseStudy
									title={project.data.title}
									domain={domain}
									api={project.data.api}
									category={project.data.category}
									year={year}
									summary={project.data.summary}
									role={project.data.role}
									problem={project.data.problem}
									approach={project.data.approach}
									outcomes={project.data.outcomes}
									engine={project.data.engine}
									features={project.data.features}
									performanceMetrics={project.data.performance_metrics}
									externalUrl={project.data.external_url}
									youtubeUrl={project.data.youtube_url}
									images={project.data.media_images}
									buildMode={project.data.build_mode}
									buildNote={project.data.build_note}
									hasNotes={Boolean(project.body?.trim())}
									Content={Content}
								/>
							</article>
						);
					})}
				</div>
			</section>

			<section id="archive" class="scroll-mt-8 pt-24 md:pt-32">
			<header class="section-rule mb-12 grid gap-6 lg:grid-cols-[18rem_minmax(0,1fr)] lg:items-end">
				<p class="mono text-[10px] uppercase tracking-[0.16em] text-muted">Work archive / {atlasProjects.length} entries</p>
				<div class="grid gap-5 md:grid-cols-[minmax(0,1fr)_minmax(18rem,0.65fr)] md:items-end">
					<h2 class="text-5xl font-medium leading-none text-paper md:text-7xl">All<br /> projects.</h2>
					<p class="max-w-xl text-base leading-relaxed text-muted">Professional work, personal engines, experiments, and smaller tools.</p>
				</div>
			</header>

			<section class="grid gap-6 lg:grid-cols-[18rem_minmax(0,1fr)]">
				<aside class="soft-panel h-fit border-1 border-line bg-surface p-4 md:p-5 lg:sticky lg:top-6">
					<div class="flex items-center justify-between gap-3 lg:hidden">
						<div>
							<p class="mono text-[11px] uppercase tracking-[0.14em] text-muted">Project index</p>
							<p class="mt-1 text-sm text-muted">Filter the archive</p>
						</div>
						<button id="atlas-filters-toggle" type="button" class="atlas-chip shrink-0" aria-expanded="false" aria-controls="atlas-filters-panel">Show Filters</button>
					</div>
					<div id="atlas-filters-panel" class="mt-4 hidden space-y-4 lg:mt-0 lg:block">
						<div>
							<label for="atlas-search" class="mono text-[11px] uppercase tracking-[0.14em] text-muted">Search</label>
							<input id="atlas-search" type="text" placeholder="title, feature, summary" class="mt-2 w-full border-1 border-line bg-ground px-3 py-2 text-sm text-paper placeholder:text-muted focus:border-signal" />
						</div>

						<div>
							<p class="mono text-[11px] uppercase tracking-[0.14em] text-muted">Sort</p>
							<select id="atlas-sort" class="atlas-select mt-2 w-full border-1 border-line bg-ground px-3 py-2 text-sm text-paper focus:border-signal">
								<option value="newest">Newest</option>
								<option value="oldest">Oldest</option>
								<option value="title">Title A-Z</option>
							</select>
						</div>

						<div>
							<p class="mono text-[11px] uppercase tracking-[0.14em] text-muted">Domain</p>
							<div class="mt-2 flex flex-wrap gap-2" data-filter-group="domain">
								<button class="atlas-chip atlas-chip-active" data-filter="all" type="button">All</button>
								{domains.map((domain) => <button class="atlas-chip" data-filter={domain} type="button">{domain}</button>)}
							</div>
						</div>

						<div>
							<p class="mono text-[11px] uppercase tracking-[0.14em] text-muted">Type</p>
							<div class="mt-2 flex flex-wrap gap-2" data-filter-group="category">
								<button class="atlas-chip atlas-chip-active" data-filter="all" type="button">All</button>
								{categories.map((category) => <button class="atlas-chip" data-filter={category} type="button">{category}</button>)}
							</div>
						</div>

						<div>
							<p class="mono text-[11px] uppercase tracking-[0.14em] text-muted">API</p>
							<div class="mt-2 flex flex-wrap gap-2" data-filter-group="api">
								<button class="atlas-chip atlas-chip-active" data-filter="all" type="button">All</button>
								{apis.map((api) => <button class="atlas-chip" data-filter={api} type="button">{api}</button>)}
							</div>
						</div>

						<div>
							<p class="mono text-[11px] uppercase tracking-[0.14em] text-muted">Timeline</p>
							<div class="mt-2 flex flex-wrap gap-2" data-filter-group="year">
								<button class="atlas-chip atlas-chip-active" data-filter="all" type="button">All</button>
								{years.map((year) => <button class="atlas-chip" data-filter={String(year)} type="button">{year}</button>)}
							</div>
						</div>

						<button id="atlas-reset" type="button" class="atlas-chip w-full">Reset Filters</button>
					</div>
				</aside>

				<div class="space-y-5">
					<div id="atlas-grid" class="grid gap-5 xl:grid-cols-2">
						{atlasProjects.map(({ project, domain, year, Content }, projectIndex) => {
							const previewImage = project.data.media_images?.[0];

							return (
								<article
									class="atlas-card soft-panel card-pop overflow-hidden border-1 border-line bg-surface"
									data-project-card
									data-title={project.data.title.toLowerCase()}
									data-summary={project.data.summary.toLowerCase()}
									data-features={project.data.features.join(' ').toLowerCase()}
									data-domain={domain}
									data-category={project.data.category}
									data-api={project.data.api ?? ''}
									data-year={String(year)}
									data-ts={String(project.data.date.getTime())}
								>
									{previewImage && (
										<div class="relative h-44 overflow-hidden border-b border-line">
											<img src={withBase(previewImage, import.meta.env.BASE_URL)} alt={`${project.data.title} preview`} class="h-full w-full object-cover" loading="lazy" />
										</div>
									)}
									<div class="space-y-3 p-5">
										<div class="flex items-start justify-between gap-3">
											<div class="flex flex-wrap items-center gap-2">
												<span class="meta-chip">{domain}</span>
												{project.data.api && <span class="meta-chip">{project.data.api}</span>}
												<span class="meta-chip">{project.data.category}</span>
												<span class="meta-chip">{year}</span>
												{project.data.build_mode === 'Agent-directed' && <span class="meta-chip build-chip">Agent-directed</span>}
											</div>
											<p class="mono shrink-0 text-[10px] tracking-[0.12em] text-signal">/{String(projectIndex + 1).padStart(2, '0')}</p>
										</div>
										<h3 class="text-2xl font-semibold leading-tight text-paper">{project.data.title}</h3>
										<p class="text-sm leading-relaxed text-muted">{project.data.summary}</p>
										<div class="grid gap-4 md:grid-cols-[1fr_auto] md:items-start">
											<p class="text-sm leading-relaxed text-muted/85">{project.data.features.slice(0, 3).join(' · ')}</p>
											<div class="flex items-center justify-end gap-2">
											<button
												type="button"
												class="case-study-toggle atlas-expand-toggle atlas-chip"
												aria-expanded="false"
												data-closed-label="More Info"
											>
												More Info
												</button>
											</div>
										</div>
									</div>

									<ProjectCaseStudy
										title={project.data.title}
										domain={domain}
										api={project.data.api}
										category={project.data.category}
										year={year}
										summary={project.data.summary}
										role={project.data.role}
										problem={project.data.problem}
										approach={project.data.approach}
										outcomes={project.data.outcomes}
										engine={project.data.engine}
										features={project.data.features}
										performanceMetrics={project.data.performance_metrics}
										externalUrl={project.data.external_url}
										youtubeUrl={project.data.youtube_url}
										images={project.data.media_images}
										buildMode={project.data.build_mode}
										buildNote={project.data.build_note}
										hasNotes={Boolean(project.body?.trim())}
										Content={Content}
									/>
								</article>
							);
						})}
					</div>

					<div class="flex flex-wrap items-center justify-between gap-4">
						<p id="atlas-empty" class="hidden text-sm text-muted">
							No projects match the current filter set.
							<button id="atlas-empty-reset" type="button" class="ml-2 underline decoration-signal underline-offset-4 hover:text-paper">Reset filters</button>
						</p>
						<button id="atlas-load-more" type="button" class="atlas-chip">Load More</button>
					</div>
				</div>
			</section>

			<div id="atlas-island-overlay" class="atlas-island-overlay hidden" aria-hidden="true">
				<div class="atlas-island-shell soft-panel border-1 border-line bg-surface" role="dialog" aria-modal="true" aria-label="Project detail">
					<div class="flex shrink-0 items-center justify-between gap-3 border-b border-line px-4 py-3 md:px-5">
						<p class="mono text-[11px] uppercase tracking-[0.14em] text-muted">Project detail</p>
						<button id="atlas-island-close" type="button" class="atlas-chip">Close</button>
					</div>
					<div id="atlas-island-content" class="atlas-island-scroll"></div>
				</div>
				<div id="atlas-image-preview" class="atlas-image-preview hidden" aria-hidden="true">
					<button id="atlas-image-preview-close" type="button" class="atlas-chip atlas-image-preview-close">Close Preview</button>
					<img id="atlas-image-preview-img" src="" alt="Project media preview" class="atlas-image-preview-img" />
				</div>
			</div>
		</div>

		<script is:inline>
			(() => {
				const cards = Array.from(document.querySelectorAll('#atlas-grid .atlas-card'));
				const searchInput = document.getElementById('atlas-search');
				const sortSelect = document.getElementById('atlas-sort');
				const emptyState = document.getElementById('atlas-empty');
				const loadMoreButton = document.getElementById('atlas-load-more');
				const resetButton = document.getElementById('atlas-reset');
				const filtersToggle = document.getElementById('atlas-filters-toggle');
				const filtersPanel = document.getElementById('atlas-filters-panel');
				const groups = Array.from(document.querySelectorAll('[data-filter-group]'));
				const expandToggles = Array.from(document.querySelectorAll('.case-study-toggle'));
				const islandOverlay = document.getElementById('atlas-island-overlay');
				const islandContent = document.getElementById('atlas-island-content');
				const islandClose = document.getElementById('atlas-island-close');
				const imagePreview = document.getElementById('atlas-image-preview');
				const imagePreviewImg = document.getElementById('atlas-image-preview-img');
				const imagePreviewClose = document.getElementById('atlas-image-preview-close');

				if (!cards.length || !searchInput || !sortSelect || !emptyState || !loadMoreButton || !resetButton) return;

				const state = {
					search: '',
					domain: 'all',
					category: 'all',
					api: 'all',
					year: 'all',
					sort: 'newest',
					limit: 6
				};

				const allowedValues = (groupName) => {
					const group = groups.find((node) => node.getAttribute('data-filter-group') === groupName);
					if (!group) return [];
					return Array.from(group.querySelectorAll('.atlas-chip')).map((chip) => chip.getAttribute('data-filter'));
				};

				const params = new URLSearchParams(window.location.search);
				(['domain', 'category', 'api', 'year']).forEach((key) => {
					const value = params.get(key);
					if (value && allowedValues(key).includes(value)) state[key] = value;
				});
				const sortParam = params.get('sort');
				if (sortParam && Array.from(sortSelect.options).some((option) => option.value === sortParam)) {
					state.sort = sortParam;
				}
				const searchParam = params.get('search');
				if (searchParam) state.search = searchParam;

				searchInput.value = state.search;
				sortSelect.value = state.sort;

				const syncFiltersVisibility = () => {
					if (!filtersToggle || !filtersPanel) return;
					const isDesktop = window.matchMedia('(min-width: 1024px)').matches;
					const isOpen = isDesktop || !filtersPanel.classList.contains('hidden');
					filtersToggle.setAttribute('aria-expanded', String(isOpen));
					filtersToggle.textContent = isOpen ? 'Hide Filters' : 'Show Filters';
				};

				if (filtersToggle && filtersPanel) {
					filtersToggle.addEventListener('click', () => {
						if (window.matchMedia('(min-width: 1024px)').matches) return;
						filtersPanel.classList.toggle('hidden');
						syncFiltersVisibility();
					});

					window.addEventListener('resize', syncFiltersVisibility);
					syncFiltersVisibility();
				}

				const setActiveChip = (groupName, value) => {
					const group = groups.find((node) => node.getAttribute('data-filter-group') === groupName);
					if (!group) return;
					group.querySelectorAll('.atlas-chip').forEach((chip) => {
						const isActive = chip.getAttribute('data-filter') === value;
						chip.classList.toggle('atlas-chip-active', isActive);
						chip.setAttribute('aria-pressed', String(isActive));
					});
				};

				const updateURL = () => {
					const nextParams = new URLSearchParams();
					if (state.search) nextParams.set('search', state.search);
					if (state.domain !== 'all') nextParams.set('domain', state.domain);
					if (state.category !== 'all') nextParams.set('category', state.category);
					if (state.api !== 'all') nextParams.set('api', state.api);
					if (state.year !== 'all') nextParams.set('year', state.year);
					if (state.sort !== 'newest') nextParams.set('sort', state.sort);
					const query = nextParams.toString();
					window.history.replaceState({}, '', query ? `?${query}` : window.location.pathname);
				};

				const apply = () => {
					const search = state.search.trim().toLowerCase();
					const filtered = cards.filter((card) => {
						const haystack = `${card.dataset.title} ${card.dataset.summary} ${card.dataset.features}`;
						const matchesSearch = !search || haystack.includes(search);
						const matchesDomain = state.domain === 'all' || card.dataset.domain === state.domain;
						const matchesCategory = state.category === 'all' || card.dataset.category === state.category;
						const matchesApi = state.api === 'all' || card.dataset.api === state.api;
						const matchesYear = state.year === 'all' || card.dataset.year === state.year;
						return matchesSearch && matchesDomain && matchesCategory && matchesApi && matchesYear;
					});

					filtered.sort((a, b) => {
						if (state.sort === 'title') return (a.dataset.title || '').localeCompare(b.dataset.title || '');
						const delta = Number(b.dataset.ts || 0) - Number(a.dataset.ts || 0);
						return state.sort === 'oldest' ? -delta : delta;
					});

					cards.forEach((card) => card.classList.add('atlas-card-hidden'));
					filtered.forEach((card, index) => {
						card.classList.toggle('atlas-card-hidden', index >= state.limit);
					});

					emptyState.classList.toggle('hidden', filtered.length > 0);
					loadMoreButton.classList.toggle('hidden', filtered.length <= state.limit);

					const grid = document.getElementById('atlas-grid');
					if (grid) {
						filtered.forEach((card) => grid.appendChild(card));
					}

					updateURL();
					setupInfiniteScroll();
				};

				let islandReturnFocus = null;

				const activateCaseTab = (tab) => {
					const root = tab.closest('[data-case-study]');
					if (!root) return;

					const target = tab.getAttribute('data-case-tab');
					root.querySelectorAll('[data-case-tab]').forEach((item) => {
						const selected = item === tab;
						item.setAttribute('aria-selected', selected ? 'true' : 'false');
						item.tabIndex = selected ? 0 : -1;
					});
					root.querySelectorAll('[data-case-panel]').forEach((panel) => {
						panel.hidden = panel.getAttribute('data-case-panel') !== target;
					});

					if (islandContent) islandContent.scrollTop = 0;
				};

				const trapIslandFocus = (event) => {
					if (event.key !== 'Tab' || !islandOverlay || islandOverlay.classList.contains('hidden')) return;
					const shell = islandOverlay.querySelector('.atlas-island-shell');
					if (!shell) return;

					const focusable = Array.from(
						shell.querySelectorAll('a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])')
					).filter((element) => element.offsetParent !== null);
					if (!focusable.length) return;

					const first = focusable[0];
					const last = focusable[focusable.length - 1];
					if (event.shiftKey && document.activeElement === first) {
						event.preventDefault();
						last.focus();
					} else if (!event.shiftKey && document.activeElement === last) {
						event.preventDefault();
						first.focus();
					}
				};

				const closeIsland = () => {
					if (!islandOverlay || !islandContent) return;
					if (imagePreview && imagePreviewImg) {
						imagePreview.classList.add('hidden');
						imagePreview.setAttribute('aria-hidden', 'true');
						imagePreviewImg.setAttribute('src', '');
					}
					islandOverlay.classList.add('hidden');
					islandOverlay.setAttribute('aria-hidden', 'true');
					islandContent.innerHTML = '';
					document.body.classList.remove('atlas-island-open');
					expandToggles.forEach((toggle) => {
						toggle.setAttribute('aria-expanded', 'false');
						toggle.textContent = toggle.dataset.closedLabel || 'Project detail';
					});
					if (islandReturnFocus) {
						islandReturnFocus.focus();
						islandReturnFocus = null;
					}
				};

				const closeImagePreview = () => {
					if (!imagePreview || !imagePreviewImg) return;
					imagePreview.classList.add('hidden');
					imagePreview.setAttribute('aria-hidden', 'true');
					imagePreviewImg.setAttribute('src', '');
				};

				expandToggles.forEach((toggle) => {
					toggle.addEventListener('click', (e) => {
						e.stopPropagation();
						if (!islandOverlay || !islandContent) return;
						const card = toggle.closest('[data-project-card]');
						if (!card) return;
						const template = card.querySelector('.atlas-island-template');
						if (!template) return;

						expandToggles.forEach((chip) => {
							chip.setAttribute('aria-expanded', 'false');
							chip.textContent = chip.dataset.closedLabel || 'Project detail';
						});

						islandContent.innerHTML = '';
						islandContent.appendChild(template.content.cloneNode(true));
						islandOverlay.classList.remove('hidden');
						islandOverlay.setAttribute('aria-hidden', 'false');
						document.body.classList.add('atlas-island-open');

						toggle.setAttribute('aria-expanded', 'true');
						toggle.textContent = 'Opened';
						islandReturnFocus = toggle;

						const activeTab = islandContent.querySelector('[data-case-tab][aria-selected="true"]');
						(activeTab || islandClose)?.focus();
					});
				});

				document.querySelectorAll('[data-project-card]').forEach((card) => {
					card.addEventListener('click', (e) => {
						if (e.target.closest('a, button')) return;
						const toggle = card.querySelector('.case-study-toggle');
						if (toggle) toggle.click();
					});
				});

				if (islandClose) {
					islandClose.addEventListener('click', closeIsland);
				}

				if (islandContent && imagePreview && imagePreviewImg) {
					islandContent.addEventListener('click', (event) => {
						const target = event.target;
						if (!(target instanceof HTMLImageElement)) return;
						const source = target.getAttribute('src');
						if (!source) return;

						imagePreviewImg.setAttribute('src', source);
						imagePreviewImg.setAttribute('alt', target.getAttribute('alt') || 'Project media preview');
						imagePreview.classList.remove('hidden');
						imagePreview.setAttribute('aria-hidden', 'false');
					});
				}

				if (islandContent) {
					islandContent.addEventListener('click', (event) => {
						const tab = event.target.closest('[data-case-tab]');
						if (tab) activateCaseTab(tab);
					});

					islandContent.addEventListener('keydown', (event) => {
						const tab = event.target.closest('[data-case-tab]');
						if (!tab) return;

						const tabs = Array.from(tab.parentElement.querySelectorAll('[data-case-tab]'));
						const index = tabs.indexOf(tab);
						let next = null;
						if (event.key === 'ArrowRight') next = tabs[(index + 1) % tabs.length];
						else if (event.key === 'ArrowLeft') next = tabs[(index - 1 + tabs.length) % tabs.length];
						else if (event.key === 'Home') next = tabs[0];
						else if (event.key === 'End') next = tabs[tabs.length - 1];
						if (!next) return;

						event.preventDefault();
						activateCaseTab(next);
						next.focus();
					});
				}

				document.addEventListener('keydown', trapIslandFocus);

				if (imagePreviewClose) {
					imagePreviewClose.addEventListener('click', closeImagePreview);
				}

				if (imagePreview) {
					imagePreview.addEventListener('click', (event) => {
						if (event.target === imagePreview) closeImagePreview();
					});
				}

				if (islandOverlay) {
					islandOverlay.addEventListener('click', (event) => {
						if (event.target === islandOverlay) closeIsland();
					});
				}

				document.addEventListener('keydown', (event) => {
					if (event.key !== 'Escape') return;
					if (imagePreview && !imagePreview.classList.contains('hidden')) {
						closeImagePreview();
						return;
					}
					closeIsland();
				});

				groups.forEach((group) => {
					const key = group.getAttribute('data-filter-group');
					if (!key) return;
					setActiveChip(key, state[key]);
					group.querySelectorAll('.atlas-chip').forEach((chip) => {
						chip.addEventListener('click', () => {
							state[key] = chip.getAttribute('data-filter') || 'all';
							state.limit = 6;
							setActiveChip(key, state[key]);
							apply();
						});
					});
				});

				searchInput.addEventListener('input', (event) => {
					state.search = event.target.value;
					state.limit = 6;
					apply();
				});

				sortSelect.addEventListener('change', (event) => {
					state.sort = event.target.value;
					apply();
				});

				loadMoreButton.addEventListener('click', () => {
					state.limit += 6;
					apply();
				});

				const resetFilters = () => {
					state.search = '';
					state.domain = 'all';
					state.category = 'all';
					state.api = 'all';
					state.year = 'all';
					state.sort = 'newest';
					state.limit = 6;
					searchInput.value = '';
					sortSelect.value = 'newest';
					setActiveChip('domain', 'all');
					setActiveChip('category', 'all');
					setActiveChip('api', 'all');
					setActiveChip('year', 'all');
					apply();
				};

				resetButton.addEventListener('click', resetFilters);
				document.getElementById('atlas-empty-reset')?.addEventListener('click', resetFilters);

				// Infinite scroll: one sentinel, one observer, reused across every filter change.
				const setupInfiniteScroll = () => {
					const grid = document.getElementById('atlas-grid');
					if (!grid || document.getElementById('atlas-scroll-sentinel')) return;

					const sentinel = document.createElement('div');
					sentinel.id = 'atlas-scroll-sentinel';
					grid.parentNode?.insertBefore(sentinel, grid.nextSibling);

					const observer = new IntersectionObserver((entries) => {
						entries.forEach((entry) => {
							if (entry.isIntersecting && !loadMoreButton.classList.contains('hidden')) {
								state.limit += 6;
								apply();
							}
						});
					}, { rootMargin: '200px' });

					observer.observe(sentinel);
				};

				apply();
			})();
		</script>
	</main>

