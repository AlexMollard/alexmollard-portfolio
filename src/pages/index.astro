			<div class="grid gap-8 lg:grid-cols-[minmax(0,1.15fr)_minmax(22rem,0.85fr)] lg:gap-14">
				<div>
					<p class="mono text-[10px] uppercase tracking-[0.16em] text-signal">Contact</p>
					<a href="mailto:alexmollard@protonmail.com" class="footer-email mt-4 inline-block text-2xl font-medium leading-snug text-paper underline decoration-signal underline-offset-8 sm:text-3xl">alexmollard@protonmail.com</a>
					<p class="mt-4 max-w-md text-sm leading-relaxed text-muted">Senior Generalist Programmer at Big Ant Studios, Melbourne. Open to talking about rendering, engine architecture, and tools work.</p>
				</div>

				<div class="border-t border-line pt-5 lg:border-l lg:border-t-0 lg:pl-8 lg:pt-1">
					<p class="mono text-[9px] uppercase tracking-[0.14em] text-muted">Links</p>
					<div class="mt-3 grid grid-cols-2 gap-3">
						<a href={cvHref} class="hero-action" download>Download CV <span aria-hidden="true">↓</span></a>
						<a href="https://au.linkedin.com/in/alex-mollard" target="_blank" rel="noreferrer" class="hero-action">LinkedIn <span aria-hidden="true">↗</span></a>
						<a href="https://github.com/AlexMollard" target="_blank" rel="noreferrer" class="hero-action">GitHub <span aria-hidden="true">↗</span></a>
						<a href="#top" class="hero-action">Back to top <span aria-hidden="true">↑</span></a>
					</div>
				</div>
			</div>

			<div class="mt-9 border-t border-line pt-4 text-muted">
				<p class="mono text-[9px] uppercase tracking-[0.14em]">© {new Date().getFullYear()} Alex Mollard</p>
			</div>
		</div>
	</footer>
</Layout>
